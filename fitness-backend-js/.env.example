# 사진 분석(식단 사진, 체성분 결과지)에 쓸 키. 둘 중 하나만 있으면 됩니다.
# 파이썬 백엔드도 이 파일을 함께 읽습니다.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# 모델을 바꾸고 싶을 때만 (기본: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# 소셜 로그인(Supabase). 없으면 로그인 버튼이 비활성으로 표시되고
# 나머지 기능은 게스트로 그대로 동작합니다.
# 프론트의 VITE_SUPABASE_URL과 같은 값을 넣으세요.
SUPABASE_URL=
SUPABASE_ANON_KEY=
